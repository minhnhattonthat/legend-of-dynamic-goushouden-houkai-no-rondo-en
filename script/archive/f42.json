  "status": "",
  "notes": ""
 },
 {
  "id": "42.11",
  "msg": [
   10195
  ],
  "jp": "えん魔くん\nへへっ！ まぁな…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.12",
  "msg": [
   10196
  ],
  "jp": "不動明\nこいつ やっぱり怪しいぜ！\n何か つかんでやがる…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.13",
  "msg": [
   10197
  ],
  "jp": "{p}\n明君…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.14",
  "msg": [
   10198
  ],
  "jp": "えん魔くん\nその屋敷に行きたければ\n沼に戻ってみなよ じゃあな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.15",
  "msg": [
   10199
  ],
  "jp": "不動明\n…逃げられた！\n沼へ行くぞ {p}！",
