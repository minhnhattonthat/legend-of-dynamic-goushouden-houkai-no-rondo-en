  "status": "",
  "notes": ""
 },
 {
  "id": "42.16",
  "msg": [
   10200
  ],
  "jp": "{p}\n…もしかして あのメールは\nえん魔くんから…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.17",
  "msg": [
   10210
  ],
