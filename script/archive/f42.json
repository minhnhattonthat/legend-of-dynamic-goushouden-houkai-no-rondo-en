  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.09",
  "msg": [
   10193
  ],
  "jp": "えん魔くん\nふ～ん\n黒い月に 沼に浮かぶ屋敷ねぇ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.10",
  "msg": [
   10194
  ],
