  "status": "",
  "notes": ""
 },
 {
  "id": "42.04",
  "msg": [
   10188
  ],
  "jp": "えん魔くん\nそうだ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.05",
  "msg": [
   10189
  ],
  "jp": "不動明\n（デーモンの身体を乗っ取った\n俺からなら ともかく\n{p}の身体からも\n妖気が出てるってのは 妙だな）",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "42.06",
  "msg": [
   10190
  ],
