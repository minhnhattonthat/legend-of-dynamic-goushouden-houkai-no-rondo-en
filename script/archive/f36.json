[
 {
  "id": "36.00",
  "msg": [
   9001
  ],
  "jp": "{p}\nドラゴンに襲われてる！？\n助けなきゃ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.01",
  "msg": [
   9002
  ],
  "jp": "ドラゴン\nおのれ 邪魔立てするか！？\n容赦せんぞ！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.02",
  "msg": [
   9003
  ],
  "jp": "ドラゴン\n容赦せんぞ！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.03",
  "msg": [
   9004
  ],
  "jp": "{p}\nあなたは スラムクィーン！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.04",
  "msg": [
   9005
  ],
  "jp": "スラムクィーン\n覚えてくれていたの？\nうれしいわ\n探した甲斐が あるってものね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.05",
  "msg": [
   9006
  ],
  "jp": "{p}\n僕を探していた…だって？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.06",
  "msg": [
   9007
  ],
  "jp": "スラムクィーン\nそうよ… 見たでしょ？\nドラゴンが私を襲うのを…？\nドラゴンが\n魔王に操られてしまったのよ\nスラムキングを捨てて",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.07",
  "msg": [
   9008
  ],
  "jp": "{p}\nまさか 僕を魔王に引き渡し\nドラゴン達を元に戻そうと！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.08",
  "msg": [
   9009
  ],
  "jp": "スラムクィーン\nあたしは それほど\nバカじゃないわ\n魔王に あなたを引き渡したら\n恐ろしいことが起こる！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.09",
  "msg": [
   9010
  ],
  "jp": "{p}\nそれじゃ どうして僕を？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.10",
  "msg": [
   9011
  ],
  "jp": "スラムクィーン\nあなたが「始まりの丘」に\n向かう姿を 夢で見たの…\nそれがあたしの力 予知夢よ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.11",
  "msg": [
   9012
  ],
  "jp": "{p}\n………",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.12",
  "msg": [
   9013
  ],
  "jp": "スラムクィーン\nいずれあなたは「始まりの丘」に\n向かうでしょう\n魔王と戦うために！\nそれが あなたの運命！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.13",
  "msg": [
   9014
  ],
  "jp": "{p}\n僕の運命… 教えて！\nそれで僕はどうなるの！？\n{s}は…！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.14",
  "msg": [
   9015
  ],
  "jp": "スラムクィーン\nわからないわ でもたったひとつ\n明らかなことがあるの\nそれはあなたが 魔王と戦える\n唯一の人ってことよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.15",
  "msg": [
   9016
  ],
  "jp": "スラムクィーン\n一緒に来なさい\nスラムキングに逢わせるわ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.16",
  "msg": [
   9017
  ],
  "jp": "{p}\n…！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.17",
  "msg": [
   9018
  ],
  "jp": "スラムクィーン\nスラムキングに反旗を翻したのは\nドラゴンだけじゃないの\nもちろん みな\n魔王に操られてのことよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.18",
  "msg": [
   9019
  ],
  "jp": "{p}\n………",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.19",
  "msg": [
   9020
  ],
  "jp": "スラムクィーン\n人々が操られ始めたのは\n異変の前兆\nスラムキングも\nそれは理解しているわ\nそこで あたしに\n探すように命じたのよ\n最悪の事態を回避出来る者を…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.20",
  "msg": [
   9021
  ],
  "jp": "{p}\n…わかった\nスラムキングに逢おう！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.21",
  "msg": [
   9022
  ],
  "jp": "スラムクィーン\nいい子ね…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.22",
  "msg": [
   9023
  ],
  "jp": "スラムキング\n待ちかねたぞ スラムクィーン！\n救世主は見つかったか！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.23",
  "msg": [
   9024
  ],
  "jp": "スラムクィーン\nお連れしましたわ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.24",
  "msg": [
   9025
  ],
  "jp": "スラムキング\nご苦労！ よくやった！\n救世主どのよ いざ ここに！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.25",
  "msg": [
   9026
  ],
  "jp": "{p}\nあ あの… こんにちは",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.26",
  "msg": [
   9027
  ],
  "jp": "スラムキング\nスラムクィーン\nこれは何の冗談だ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.27",
  "msg": [
   9028
  ],
  "jp": "スラムクィーン\nこの者こそ 異変から関東を\n世界を救う人物ですわ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.28",
  "msg": [
   9029
  ],
  "jp": "{p}\nえ え～と {p}です",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.29",
  "msg": [
   9030
  ],
  "jp": "スラムキング\nあっはっはっはっは！\n片腹痛い！\nスラムクィーン おまえの力も\n衰えたようだな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.30",
  "msg": [
   9031
  ],
  "jp": "スラムクィーン\nならば 立ち合ってみては\nいかがですか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.31",
  "msg": [
   9032
  ],
  "jp": "{p}\nええ～っ！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.32",
  "msg": [
   9033
  ],
  "jp": "スラムキング\nあ～っはっはっはっは！\n\nこの俺に 子供の相手を\nしろというのか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.33",
  "msg": [
   9034
  ],
  "jp": "スラムクィーン\nもしも あなたと立ち合い\nそして死んだならば\nそれは あたしの予知夢が外れた\n…ということ\nその時は あたしも死にましょう！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.34",
  "msg": [
   9035
  ],
  "jp": "{p}\n…！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.35",
  "msg": [
   9036
  ],
  "jp": "スラムキング\nそこまで この子供に賭けるか\nスラムクィーン…\nならば 立ち合おうではないか！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.36",
  "msg": [
   9037
  ],
  "jp": "スラムキング\nいざ 来い！ {p}よ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.37",
  "msg": [
   9038
  ],
  "jp": "スラムキング\n不覚…！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.38",
  "msg": [
   9039
  ],
  "jp": "スラムクィーン\nスラムキング この子を\nお認め下さいますね？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.39",
  "msg": [
   9040
  ],
  "jp": "スラムキング\n致し方あるまい！\n\n{p}よ！ スラムキング\nおまえに助力するぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.40",
  "msg": [
   9041
  ],
  "jp": "{p}\nは はい…！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.41",
  "msg": [
   9042
  ],
  "jp": "スラムキング\nスラムクィーン！\n共をいたせ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.42",
  "msg": [
   9043
  ],
  "jp": "スラムクィーン\n{p}\nおみごとだったわ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.43",
  "msg": [
   9044
  ],
  "jp": "{p}\nありがとう\nスラムクィーンさん！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.44",
  "msg": [
   9045
  ],
  "jp": "住民\n噂だけど スラムキングが\n大変なことになってるらしいぞ\nドラゴンからも暴徒になった連中が\n出たらしくてさ…\nいったい 関東に\n何が起ころうとしてるんだ…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.45",
  "msg": [
   9101
  ],
  "jp": "{p}\n誰もいないのかな？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.46",
  "msg": [
   9102
  ],
  "jp": "ヒゲゴジラ\n今日 女子の方達は\n身体検査がありますから\nお残りになってねぇ～\nおほほほほ\n男子の方は さっさと\n帰ってちょね～ イッヒッヒ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.47",
  "msg": [
   9103
  ],
  "jp": "ヒゲゴジラ\n…なんて言っても\n誰もいないのよ～\nはぁ～ さみちいのよ～",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.48",
  "msg": [
   9104
  ],
  "jp": "{p}\nひとりで 何やってるの…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.49",
  "msg": [
   9105
  ],
  "jp": "ヒゲゴジラ\n世の中 物騒になっちゃって\nイヤだわ～\nそれで\n生徒も来なくなっちゃったの…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.50",
  "msg": [
   9106
  ],
  "jp": "ヒゲゴジラ\n里帰りする お金もなく あたちは\nひとり 授業を続けるのよ～！\nおよよ およよ うわ～ん！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.51",
  "msg": [
   9110
  ],
  "jp": "山岸\nヒゲゴジラ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.52",
  "msg": [
   9111
  ],
  "jp": "ヒゲゴジラ\nその声は…！？\n\nきゃ～！\nわたち うれちいわよ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.53",
  "msg": [
   9112
  ],
  "jp": "ヒゲゴジラ\nう～ん ぶちゅ！ ぶちゅ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.54",
  "msg": [
   9113
  ],
  "jp": "山岸\nやめやがれ！ 気色悪ぃ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.55",
  "msg": [
   9114
  ],
  "jp": "十兵衛\nイヤ～ン やめて！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.56",
  "msg": [
   9115
  ],
  "jp": "袋小路\nうわっ なんだよ こいつ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.57",
  "msg": [
   9116
  ],
  "jp": "ヒゲゴジラ\nさみちいのよぉ～！\n\nお願い わたちを連れてってぇ～ん！\nね！ ね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.58",
  "msg": [
   9117
  ],
  "jp": "山岸\nしょうがねぇなぁ そのかわり\n俺の召し使いだぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.59",
  "msg": [
   9118
  ],
  "jp": "十兵衛\n先生 なんだか かわいそう…\nいいわ 連れて行ってあげる！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.60",
  "msg": [
   9119
  ],
  "jp": "袋小路\nわかったよ\nオヤブンに話してやるよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.61",
  "msg": [
   9120
  ],
  "jp": "ヒゲゴジラ\nきゃ～！ うれし～！\n一生ついてくわ～！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.62",
  "msg": [
   9121
  ],
  "jp": "{p}\n里帰りするのに\nいくら かかるんだい？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.63",
  "msg": [
   9122
  ],
  "jp": "ヒゲゴジラ\n初乗り１３０円よ～\n改札さえ通っちゃえば 後は…\nイヒヒ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.64",
  "msg": [
   9123
  ],
  "jp": "ヒゲゴジラ\nま～ わたち うれちいわ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.65",
  "msg": [
   9124
  ],
  "jp": "ヒゲゴジラ\nう～ん ぶちゅ！ ぶちゅ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.66",
  "msg": [
   9125
  ],
  "jp": "ヒゲゴジラ\nわたち\n里帰り出来てうれちいのよ～\nおかあちゃま～！\n\nあなたのさゆりが\n今 帰るわよ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.67",
  "msg": [
   9201
  ],
  "jp": "鬼仏衆\n壊せ 壊せ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.68",
  "msg": [
   9202
  ],
  "jp": "鬼仏衆\n鬼獄界など\nもはや存在しないのだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.69",
  "msg": [
   9203
  ],
  "jp": "鬼仏衆\n魔王が世界を再生する！\n鬼獄界は不要！ 暗黒寺も不要！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.70",
  "msg": [
   9205
  ],
  "jp": "鬼仏衆\nおぬしは…！\n魔王が求める「再生の太陽」！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.71",
  "msg": [
   9206
  ],
  "jp": "鬼仏衆\nおぬしを差し出せば\n魔王がお慶びになる！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.72",
  "msg": [
   9207
  ],
  "jp": "鬼仏衆\n魔王のために！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.73",
  "msg": [
   9208
  ],
  "jp": "鬼谷\n外が静かになったと思ったら…\n手天童子と一緒にいた者だな？\n鬼仏衆を倒してくれたのか",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.74",
  "msg": [
   9209
  ],
  "jp": "{p}\nあなたは 鬼谷さん？\n寺の中に いたの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.75",
  "msg": [
   9210
  ],
  "jp": "鬼谷\nいかに俺でも大勢の鬼仏衆相手に\nひとりでは どうにもならん\n寺の中で自刃し\n火をかけるつもりだったのだ\nでは…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.76",
  "msg": [
   9211
  ],
  "jp": "{p}\n…ちょ ちょっと！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.77",
  "msg": [
   9216
  ],
  "jp": "鬼谷\n外が静かになったと思ったら…\n手天童子か…\n貴様 何しに寺を訪れたのだ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.78",
  "msg": [
   9217
  ],
  "jp": "子郎\nおまえには関係のないことだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.79",
  "msg": [
   9218
  ],
  "jp": "鬼谷\nそうはいかん！ 俺は 寺を\n外敵から護らねばならぬ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.80",
  "msg": [
   9219
  ],
  "jp": "子郎\nならばなぜ 鬼仏衆に\n好き勝手させていたのだ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.81",
  "msg": [
   9220
  ],
  "jp": "鬼谷\nいかに俺でも大勢の鬼仏衆相手に\nひとりでは どうにもならん\n寺の中で自刃し\n火をかけるつもりだったのだ\nでは…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.82",
  "msg": [
   9221
  ],
  "jp": "{p}\n…ちょ ちょっと！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.83",
  "msg": [
   9222
  ],
  "jp": "子郎\n仇敵とはいえ 見捨てるわけには\nいかないな",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "36.84",
  "msg": [
   9230
  ],
  "jp": "{p}\nダメだよ\n寺に火をかけるなんて！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
