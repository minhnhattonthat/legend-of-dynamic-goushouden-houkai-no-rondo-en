  "status": "",
  "notes": ""
 },
 {
  "id": "30.27",
  "msg": [
   4938
  ],
  "jp": "グズ蟲\nい～よ～ それより～\n城に戻ってくれとさ～\n大殿が～ 目を～ 覚ましたんだ～",
