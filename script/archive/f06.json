[
 {
  "id": "06.00",
  "msg": [
   1828
  ],
  "jp": "如月ハニー\n{p} あたし達 ここで\n一休みしてるわ\nえん魔くんと 逢ってらっしゃい",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.01",
  "msg": [
   1830
  ],
  "jp": "如月ハニー\nえん魔くんとは もう話したの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.02",
  "msg": [
   1831
  ],
  "jp": "早見青児\n不思議な建物だなぁ\n\n外から見るより\n中は はるかに広いぜ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.03",
  "msg": [
   1832
  ],
  "jp": "門土\n居心地 悪くねぇな\nしばらく ここを根城にするか！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.04",
  "msg": [
   1833
  ],
  "jp": "竜馬\n飲み物や 食べ物も揃ってるよ\nいい部屋じゃん ここ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.05",
  "msg": [
   1834
  ],
  "jp": "ジャック\n地獄別荘は\n亜空間に存在しているようだ\nこれを作った 閻魔大王とは\nそうとうな力の 持ち主だ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.06",
  "msg": [
   1835
  ],
  "jp": "山岸\nうめぇ うめぇ！\nごちそうが 食い放題だぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.07",
  "msg": [
   1836
  ],
  "jp": "袋小路\nオヤブン 食べ過ぎ…\nボクも負けないス",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.08",
  "msg": [
   1837
  ],
  "jp": "十兵衛\n山岸君ったら ここに来てから\n食べてばかりよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.09",
  "msg": [
   1840
  ],
  "jp": "えん魔くん\nよう 来たな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.10",
  "msg": [
   1841
  ],
  "jp": "{p}\nえん魔くん！\n君が {s}を…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.11",
  "msg": [
   1842
  ],
  "jp": "えん魔くん\n人間界で 悪さをする妖怪達を\nやっつけるのが 俺の仕事\n俺達は\n妖怪パトロールってわけさ\nそしてパトロール中に\n{s}を見つけたんだ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.12",
  "msg": [
   1843
  ],
  "jp": "{p}\nそれじゃ {s}は\n妖怪に襲われてたの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.13",
  "msg": [
   1844
  ],
  "jp": "{s}\nいいえ 違うの\nえん魔くんの妖怪アンテナがね…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.14",
  "msg": [
   1845
  ],
  "jp": "不動明\n俺に反応したのさ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.15",
  "msg": [
   1846
  ],
  "jp": "不動明\n久しぶりだな {p}！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.16",
  "msg": [
   1847
  ],
  "jp": "{p}\n明君！ どうして君に\n妖怪アンテナが…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.17",
  "msg": [
   1848
  ],
  "jp": "不動明\n詳しいことは 後で…だ\n\n俺と一緒に戦うことがあれば\nその時に解るよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.18",
  "msg": [
   1849
  ],
  "jp": "えん魔くん\nおまえ達の身に\n何があったんだい？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.19",
  "msg": [
   1850
  ],
  "jp": "{p}\n実は…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.20",
  "msg": [
   1851
  ],
  "jp": "えん魔くん\n{p}と一緒にいた連中にも\nそんな出来事があったのか\nどう思う シャッポじい？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.21",
  "msg": [
   1852
  ],
  "jp": "シャッポじい\n黒い月とは 地獄門に似とるのう\n地獄門は 黒い月となって現れる\nじゃが 話に出てくる黒い月は…\n\nワシらの使う 地獄門とは\n違うようじゃ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.22",
  "msg": [
   1853
  ],
  "jp": "えん魔くん\n地獄門は 地獄界と人間界を\n繋いでるんだ\nでも {p}の話に\n出てくる 黒い月は…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.23",
  "msg": [
   1854
  ],
  "jp": "シャッポじい\nまるで いくつもの世界を\n繋げているかのようなんじゃ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.24",
  "msg": [
   1855
  ],
  "jp": "{p}\n世界を繋げてる…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.25",
  "msg": [
   1856
  ],
  "jp": "不動明\n異なる次元を 黒い月が\n連結している…ということか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.26",
  "msg": [
   1857
  ],
  "jp": "えん魔くん\nそうかもしれない\n俺には解んねぇけど…\n…閻魔大王様なら もしかしたら\n解るかもしれねぇな",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.27",
  "msg": [
   1858
  ],
  "jp": "{s}\n閻魔大王…って\n地獄にいるっていう あの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.28",
  "msg": [
   1859
  ],
  "jp": "えん魔くん\nそうだよ 地獄の閻魔大王！\n俺のおじさんさ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.29",
  "msg": [
   1860
  ],
  "jp": "えん魔くん\nけど地獄界に人間を連れて行ったら\nきっと大王様に怒られちゃうよ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.30",
  "msg": [
   1861
  ],
  "jp": "シャッポじい\n{p}達を\n妖怪パトロールの一員に\n加えたらどうじゃな？\n\n妖怪パトロールのメンバーなら\n\n大王様も きっと怒らんと\n思うのじゃが…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.31",
  "msg": [
   1862
  ],
  "jp": "えん魔くん\nナイス！ シャッポじい！\n\nよし！ 今日から おまえらは\n妖怪パトロールの一員だ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.32",
  "msg": [
   1863
  ],
  "jp": "えん魔くん\nおっ！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.33",
  "msg": [
   1864
  ],
  "jp": "えん魔くん\n早速 妖怪アンテナが ビビッ！と\n来たぜ 妖怪退治に行くぞ！\n仲間を決めたら\n地獄別荘の前に 集合だ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.34",
  "msg": [
   1865
  ],
  "jp": "{p}\n妖怪退治か…\n大変なことになっちゃったね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.35",
  "msg": [
   1866
  ],
  "jp": "{s}\nおっかないけど\n離れ離れでいるよりは いいわ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.36",
  "msg": [
   1880
  ],
  "jp": "えん魔くん\nパトロールのメンバーは\n決めたか？\n近くの町から\n妖気が発しているようだぜ\n先に行ってるから 後から来いよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.37",
  "msg": [
   1881
  ],
  "jp": "{p}\n町の人達\nいったいどうしたんだろう？\n急に襲いかかってくるなんて…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.38",
  "msg": [
   1882
  ],
  "jp": "シャッポじい\nえん魔くん！ ひょっとすると\nひょっとジャジャ！\nこの人の身体を\n良く見てみるのじゃ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.39",
  "msg": [
   1883
  ],
  "jp": "{p}\n…なんか ドクロみたいな\nアザがあるよ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.40",
  "msg": [
   1884
  ],
  "jp": "シャッポじい\nやはり！ 妖怪・怒黒の息を\n吸ったのジャジャ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.41",
  "msg": [
   1885
  ],
  "jp": "えん魔くん\nするって～と 怒りっぽいのは\n妖怪・怒黒のせいか…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.42",
  "msg": [
   1886
  ],
  "jp": "シャッポじい\nさよう 怒黒の息を吸うとな 誰でも\n怒り狂っちまうのジャジャ！\nヤツは地獄では 「無冠の帝王」と\n呼ばれておった！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.43",
  "msg": [
   1887
  ],
  "jp": "{p}\n無冠の帝王…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.44",
  "msg": [
   1888
  ],
  "jp": "えん魔くん\nへぇ\nそいつは おもしれぇ！\n怒黒をやっつければ\n立派な妖怪パトロールの一員だ！\n{p}を 地獄界へ\n連れて行けるぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.45",
  "msg": [
   1889
  ],
  "jp": "えん魔くん\n学校のほうから\n強い妖気を 感じるな…\nよし\n学校の中を捜してみるか！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.46",
  "msg": [
   1890
  ],
  "jp": "えん魔くん\nあちこち 妖怪だらけだなぁ\n妖怪アンテナも フル稼働だぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.47",
  "msg": [
   1891
  ],
  "jp": "{p}\nそれじゃ 怒黒の居場所は…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.48",
  "msg": [
   1892
  ],
  "jp": "えん魔くん\n妖怪アンテナじゃ解らない…って\nことだな！\nあっちこっち探して回るしかない！\nがんばれよ {p}！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.49",
  "msg": [
   1893
  ],
  "jp": "{p}\nあ！\n待ってよ えん魔くん！！\n…行っちゃった",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.50",
  "msg": [
   1900
  ],
  "jp": "えん魔くん\nややっ！\n妖しの風が吹いてきたぞ！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.51",
  "msg": [
   1901
  ],
  "jp": "シャッポじい\n無冠の帝王・大妖怪・怒黒が\nでるぞぞぞ！\nえん魔くん！ この戦いは\nきつい戦いになるのジャジャ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.52",
  "msg": [
   1902
  ],
  "jp": "怒黒\nわっはっはっは～！\n\n世紀の大妖怪・怒黒の恐ろしさ\n骨のずいまで 思い知れ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.53",
  "msg": [
   1903
  ],
  "jp": "えん魔くん\nよし！\n{p} 行け！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.54",
  "msg": [
   1904
  ],
  "jp": "{p}\n行け…って 僕が戦うの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.55",
  "msg": [
   1905
  ],
  "jp": "えん魔くん\n一人前の 妖怪パトロールなら\nこんなヤツ 倒せるだろ\nそうすれば 地獄の大王様も\nきっと 会ってくれるぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.56",
  "msg": [
   1906
  ],
  "jp": "怒黒\nおのれ 舐めおって～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.57",
  "msg": [
   1907
  ],
  "jp": "えん魔くん\nやったな {p}！\n\nこれでおまえも\n立派な妖怪パトロール隊員だ！\n俺にしっかりつかまってくれ！\n地獄界へ出発だ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.58",
  "msg": [
   1911
  ],
  "jp": "えん魔くん\nよ～し 行くぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.59",
  "msg": [
   1912
  ],
  "jp": "{p}\nうわ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.60",
  "msg": [
   1913
  ],
  "jp": "{p}\n黒い月だ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.61",
  "msg": [
   1914
  ],
  "jp": "えん魔くん\nてゆ～より 地獄門さ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.62",
  "msg": [
   1915
  ],
  "jp": "シャッポじい\nさよう\nここを抜ければ 地獄界ですぞ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.63",
  "msg": [
   1920
  ],
  "jp": "えん魔くん\n大王様 えん魔参上！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.64",
  "msg": [
   1921
  ],
  "jp": "閻魔大王\nえん魔 なにごとじゃ！\nその者達は なんじゃ？\n人間ではないか！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.65",
  "msg": [
   1922
  ],
  "jp": "えん魔くん\n大王様 こいつは 妖怪パトロールの\n新メンバーなんです！\n{p}は 妖怪・怒黒を\nやっつけたんです！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.66",
  "msg": [
   1923
  ],
  "jp": "閻魔大王\nほほう それはたいしたもんじゃ！\n\nそれで そのほう達 何用があって\n地獄に参ったのじゃ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.67",
  "msg": [
   1924
  ],
  "jp": "{p}\n実は…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.68",
  "msg": [
   1925
  ],
  "jp": "閻魔大王\nふ～む\n奇っかいな話じゃ…\nだが おまえの言う 黒い月と\n地獄門とは別物…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.69",
  "msg": [
   1926
  ],
  "jp": "{p}\nホントですか！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.70",
  "msg": [
   1927
  ],
  "jp": "閻魔大王\n黒い月の出現に続いて\n必ず地震が 起こるのじゃろう？\nえん魔くんと 一緒に\n黒い月を見つけた時\n果たして地震は 起きたかな？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.71",
  "msg": [
   1928
  ],
  "jp": "{p}\n…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.72",
  "msg": [
   1929
  ],
  "jp": "閻魔大王\nそれに\n世界は決して ひとつではない\nただ お互いに それとは気づかない\nことが多いのじゃ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.73",
  "msg": [
   1930
  ],
  "jp": "えん魔くん\n確かに人間界の連中は\n地獄界のことを知らないもんな…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.74",
  "msg": [
   1931
  ],
  "jp": "{p}\nそれじゃ 僕のいた世界は\nこことは別の世界なんですか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.75",
  "msg": [
   1932
  ],
  "jp": "閻魔大王\n恐らくそうじゃ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.76",
  "msg": [
   1933
  ],
  "jp": "{p}\nそれじゃ ハニーの世界と…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.77",
  "msg": [
   1934
  ],
  "jp": "えん魔くん\n早乙女門土と\n身堂竜馬の世界…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.78",
  "msg": [
   1935
  ],
  "jp": "閻魔大王\nそしてこの世界！\n\nすべて異なる世界であっても\n少しも不思議は ないのじゃ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.79",
  "msg": [
   1936
  ],
  "jp": "{p}\nええっ！ そんな！\n\nそれで 僕らは どうやれば\nもとの世界に戻れるんですか！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "06.80",
  "msg": [
   1937
  ],
  "jp": "閻魔大王\n解らぬ…\n\n実は他にも ワシの理解を越えた\n事件が 起きているのじゃ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
