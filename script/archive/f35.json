[
 {
  "id": "35.00",
  "msg": [
   8708
  ],
  "jp": "宇津木涼\nうむ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.01",
  "msg": [
   8710
  ],
  "jp": "{p}\n何とか宇津木さんを\n救うことは できないだろうか…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.02",
  "msg": [
   8711
  ],
  "jp": "{p}\n宇津木さん…\nあなたを助け出す事は…\nもう二度と 人間の世界に\n戻ってくることはできないの？\nあなたの妹\n沙織さんを残して…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.03",
  "msg": [
   8712
  ],
  "jp": "ダンテ\n沙織…\n俺の妹…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.04",
  "msg": [
   8713
  ],
  "jp": "{p}\n{!R}！？\n宇津木さん！！\n{!R}氷の中で\nまだ意識は生きているんだ！！\n{!R}そうだよ 宇津木さん！\n\n{!R}妹さんまで この世界から\n消すつもりかい！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.05",
  "msg": [
   8801
  ],
  "jp": "{p}\nなんで こんな機械が…\n誰が運び込んだんだろう？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.06",
  "msg": [
   8802
  ],
  "jp": "{p}\nこれ… もしかして…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.07",
  "msg": [
   8803
  ],
  "jp": "来留間源三\n「魔」の残骸だ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.08",
  "msg": [
   8804
  ],
  "jp": "{p}\n来留間博士！？\nここで いったい何を？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.09",
  "msg": [
   8805
  ],
  "jp": "来留間源三\n知れたこと！\nおまえも見ただろう\nあの「魔」の恐ろしさを！\n無尽蔵とも言えるパワーを！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.10",
  "msg": [
   8806
  ],
  "jp": "来留間源三\n見ろ この身体を！\nこの素晴らしい身体を！！\n俺は この身体に\n「魔」を組み込む！\nそして より進化した人間に\n生まれ変わるのだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.11",
  "msg": [
   8807
  ],
  "jp": "{p}\nあなたの考えには\nついていけない…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.12",
  "msg": [
   8808
  ],
  "jp": "来留間源三\nそれは\nおまえが理解出来ないだけだ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.13",
  "msg": [
   8809
  ],
  "jp": "{p}\n…………",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.14",
  "msg": [
   8810
  ],
  "jp": "来留間源三\nまぁ よい\nいずれわかる\n「魔」を取り込んだ\n俺の姿を見たら…な",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.15",
  "msg": [
   8811
  ],
  "jp": "{p}\nあなたは なぜ こんな研究を\nしているんですか？\n慎一君を… 自分の子供を\n犠牲にしてまで…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.16",
  "msg": [
   8812
  ],
  "jp": "来留間源三\n汚染され 環境が変われば\nどのような生物であれ 死滅する\n人類は 既にその日を\n目の前にしてしまった…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.17",
  "msg": [
   8813
  ],
  "jp": "{p}\n環境汚染…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.18",
  "msg": [
   8814
  ],
  "jp": "来留間源三\n新しい時代に 生き残れる生物を\n生み出さねばならぬ\n凄まじき地獄を乗り切り 新しき\n時代に導いてくれる人類を…な\nダメだ…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.19",
  "msg": [
   8815
  ],
  "jp": "来留間源三\nサンプルが足りん…\n\n生きた「魔」か\n黒い魔物が 必要だな…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.20",
  "msg": [
   8816
  ],
  "jp": "来留間源三\n黒い魔物は 貴様を狙っている\n\nおまえを守って闘えば\n無数のサンプルが手に入る！\n必要な量のサンプルを採取するまで\nおまえの安全を守ってやろう\nどうだ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.21",
  "msg": [
   8817
  ],
  "jp": "来留間源三\n良い選択だ！ では行くぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.22",
  "msg": [
   8818
  ],
  "jp": "来留間源三\nやはり子供だな この取引の\n損得勘定が 出来んとみえる…\n研究の邪魔だ 用がなければ\nさっさと出て行け！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.23",
  "msg": [
   8819
  ],
  "jp": "来留間源三\nふん 気が変わって 俺の提案を\n受け入れる気になったのか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.24",
  "msg": [
   8830
  ],
  "jp": "慎一\nオヤジ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.25",
  "msg": [
   8831
  ],
  "jp": "{p}\n来留間博士！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.26",
  "msg": [
   8832
  ],
  "jp": "来留間源三\n生きていたか 慎一…\nあの小娘は どうした？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.27",
  "msg": [
   8833
  ],
  "jp": "慎一\n真理阿は…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.28",
  "msg": [
   8834
  ],
  "jp": "慎一\n真理阿は俺の中にいる！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.29",
  "msg": [
   8835
  ],
  "jp": "来留間源三\nワッハッハッハッハ！\nそうか そうか！\n慎一 きさま 真理阿を\n取り込んだな？\nそこまでして 力を求めるとは\nさすが俺の息子だ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.30",
  "msg": [
   8836
  ],
  "jp": "慎一\nなんだと！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.31",
  "msg": [
   8837
  ],
  "jp": "{p}\n来留間博士\nあなたは ここでいったい何を？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.32",
  "msg": [
   8838
  ],
  "jp": "来留間源三\n新しい時代に 生き残れる生物を\n生み出さねばならぬ\n凄まじき地獄を乗り切り 新しき\n時代に導いてくれる人類を…な",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.33",
  "msg": [
   8839
  ],
  "jp": "慎一\nたわけた事を言うな！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.34",
  "msg": [
   8840
  ],
  "jp": "来留間源三\nおまえには やはり解らんか…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.35",
  "msg": [
   8841
  ],
  "jp": "慎一\nふざけるな！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.36",
  "msg": [
   8842
  ],
  "jp": "来留間源三\n黙れ 慎一！！\nおまえに聞いているのでは無い\nどうだ {p}？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.37",
  "msg": [
   8843
  ],
  "jp": "慎一\n{p}！？\nなぜ！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.38",
  "msg": [
   8844
  ],
  "jp": "{p}\n今は少しでも力がほしい時だよ\n\n協力してくれるなら\nこの方がいい…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.39",
  "msg": [
   8845
  ],
  "jp": "慎一\nくっ…！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.40",
  "msg": [
   8901
  ],
  "jp": "{p}\nこんなところに豹が…？\nかわいそうに… 傷だらけだ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.41",
  "msg": [
   8902
  ],
  "jp": "{p}\n行っちゃった…\nだいぶ脅えているみたい…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.42",
  "msg": [
   8903
  ],
  "jp": "パンサー団員\nあの女 どこへ隠れやがった？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.43",
  "msg": [
   8904
  ],
  "jp": "パンサー団員\n今まで 俺達を\nアゴで使いやがって！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.44",
  "msg": [
   8905
  ],
  "jp": "パンサー団員\nあの女 魔王に送ってやろうぜ！\n召し使いとしてな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.45",
  "msg": [
   8906
  ],
  "jp": "パンサー団員\nおい！ このガキ\n例のガキじゃねぇか！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.46",
  "msg": [
   8907
  ],
  "jp": "パンサー団員\nホントだ！\nこいつぁ 思わぬ拾いもんだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.47",
  "msg": [
   8908
  ],
  "jp": "パンサー団員\nシスター・ジルより\nこのガキのほうが魔王が喜ぶぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.48",
  "msg": [
   8909
  ],
  "jp": "{p}\nこの豹 あいつらに\n苛められてたんだ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.49",
  "msg": [
   8910
  ],
  "jp": "{p}\nシスター・ジルの正体は\n豹だったのか…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.50",
  "msg": [
   8911
  ],
  "jp": "シスター・ジル\nう う～ん…\nハッ！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.51",
  "msg": [
   8912
  ],
  "jp": "シスター・ジル\nおまえは 如月ハニーと\n一緒にいた 小僧だね！？\n私の手下達に\n何をした！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.52",
  "msg": [
   8913
  ],
  "jp": "{p}\n手下達に？ 何のこと？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.53",
  "msg": [
   8914
  ],
  "jp": "シスター・ジル\nしらを切るか！ 手下達を操り\n私を襲わせたクセに！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.54",
  "msg": [
   8915
  ],
  "jp": "{p}\n知らないよ！\n\nそれって 黒い魔物に\n操られたんじゃないの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.55",
  "msg": [
   8916
  ],
  "jp": "シスター・ジル\n黒い魔物だと？\n\n私を騙そうったって\nそうはいかないよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.56",
  "msg": [
   8917
  ],
  "jp": "{p}\n違うよ！ 聞いてよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.57",
  "msg": [
   8918
  ],
  "jp": "シスター・ジル\nなんと！ そのようなことが\n起こっていたのか…\nパンサー団員達を手玉にとるとは\n恐るべき敵だ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.58",
  "msg": [
   8919
  ],
  "jp": "{p}\n敵？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.59",
  "msg": [
   8920
  ],
  "jp": "シスター・ジル\nパンサー団員達を操り この\nシスター・ジル様を襲ったのだ\n私にとって 黒い魔物とは敵だ！\n\n私にもパンサークロー日本支部長\nとしての メンツがある！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.60",
  "msg": [
   8921
  ],
  "jp": "{p}\nどうするつもり？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.61",
  "msg": [
   8922
  ],
  "jp": "シスター・ジル\n知れたこと！ 魔王と戦うのだ！\n私は おまえと共に行くぞ！\nそれが魔王への近道と見た！\n異論があるか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.62",
