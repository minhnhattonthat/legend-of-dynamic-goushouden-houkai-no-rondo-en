  "jp": "{p}\nえっ？ なんか言った？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.64",
  "msg": [
   8925
  ],
  "jp": "シスター・ジル\nな なんでもないわ！\n\nさぁ ぐずぐずしないで\n行くわよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "35.65",
  "msg": [
   8926
  ],
