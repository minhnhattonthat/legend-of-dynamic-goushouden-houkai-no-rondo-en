[
 {
  "id": "37.00",
  "msg": [
   9302
  ],
  "jp": "ケダマン\nなんだと！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.01",
  "msg": [
   9303
  ],
  "jp": "怒良野\nなんでもないよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.02",
  "msg": [
   9304
  ],
  "jp": "{p}\n君達 仲がいいんだか悪いんだか\nわからないね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.03",
  "msg": [
   9305
  ],
  "jp": "ケダマン\nあっはっはっは！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.04",
  "msg": [
   9306
  ],
  "jp": "怒良野\n仲良くねぇよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.05",
  "msg": [
   9307
  ],
  "jp": "{p}\nそういえば ケダマンの家って\nどういう仕掛けだったんだろ？\nあれも 次元連鎖と\n関係あったのかな？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.06",
  "msg": [
   9310
  ],
  "jp": "美勒\n魔王が倒され\n次元連鎖が終わった以上\n九龍の谷に よそ者が迷い込むこと\nは ないだろう",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.07",
  "msg": [
   9311
  ],
  "jp": "黒死丸\n真田忍者との戦いは これからだな",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.08",
  "msg": [
   9312
  ],
  "jp": "グズ蟲\nそ～だなぁ～",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.09",
  "msg": [
   9313
  ],
  "jp": "{p}\nみんな がんばって！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.10",
  "msg": [
   9314
  ],
  "jp": "美勒\n{p}の戦い\nしかと見届けさせて貰った！\nこれからの戦い 励みになるぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.11",
  "msg": [
   9315
  ],
  "jp": "{p}\nずびずばの人によろしく！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.12",
  "msg": [
   9320
  ],
  "jp": "けっこう仮面\n君のような少年が\n果敢に魔王に立ち向かう\nその姿に 私は感動したわ！\n胸が高鳴っちゃった！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.13",
  "msg": [
   9321
  ],
  "jp": "{p}\nむ 胸が…！？\nそりゃ けっこう…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.14",
  "msg": [
   9322
  ],
  "jp": "{p}\nけっこう仮面のお姉さん\nありがとう！\nどんなに時間がたっても\nあなたの身体は忘れないよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.15",
  "msg": [
   9325
  ],
  "jp": "南友\n{p}… 僕…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.16",
  "msg": [
   9326
  ],
  "jp": "南友\nお腹減った…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.17",
  "msg": [
   9327
  ],
  "jp": "さよこ\nそうね 南友君\nいっぱい頑張ったものね！\nお屋敷へ戻ったら\nご馳走 食べさせてあげるわ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.18",
  "msg": [
   9328
  ],
  "jp": "{p}\nいやはや なんとも…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.19",
  "msg": [
   9330
  ],
  "jp": "キッカイくん\nいひひひ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.20",
  "msg": [
   9331
  ],
  "jp": "{p}\nどうしたの キッカイくん？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.21",
  "msg": [
   9332
  ],
  "jp": "キッカイくん\nなんでもないよ！\n\n元の世界に戻れると思うと\nうれしくってさ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.22",
  "msg": [
   9333
  ],
  "jp": "{p}\n………",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.23",
  "msg": [
   9334
  ],
  "jp": "キッカイくん\n今度 うちに遊びに来いよな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.24",
  "msg": [
   9335
  ],
  "jp": "{p}\nあのキッカイな家に？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.25",
  "msg": [
   9336
  ],
  "jp": "キッカイくん\nじゃ～な～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.26",
  "msg": [
   9337
  ],
  "jp": "フユカイ\n待て～！\nワシを置いてくな～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.27",
  "msg": [
   9338
  ],
  "jp": "キッカイくん\nあら おじいちゃん\n気がついちゃった？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.28",
  "msg": [
   9339
  ],
  "jp": "フユカイ\n{p}！\nこの先も がんばるんじゃぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.29",
  "msg": [
   9340
  ],
  "jp": "キッカイ\nおじいちゃんもね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.30",
  "msg": [
   9341
  ],
  "jp": "フユカイ\nどういう意味じゃ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.31",
  "msg": [
   9342
  ],
  "jp": "キッカイ\nイヒヒヒ…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.32",
  "msg": [
   9343
  ],
  "jp": "ポチ\nあ～！\n行ってしまったぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.33",
  "msg": [
   9344
  ],
  "jp": "アルフォンヌ\nポチ～！\nおまえのせいだぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.34",
  "msg": [
   9345
  ],
  "jp": "ポチ\nなんだと！？ それが ご主人様に\n向かって言うセリフか！\n元の世界に帰る方法を考えるのだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.35",
  "msg": [
   9346
  ],
  "jp": "アルフォンヌ\nいつもいつも\n考えるのは俺なのだ～！\nそれでも ご主人様か～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.36",
  "msg": [
   9347
  ],
  "jp": "ポチ\nお～ この光は…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.37",
  "msg": [
   9348
  ],
  "jp": "アルフォンヌ\n俺達も帰れるのだ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.38",
  "msg": [
   9349
  ],
  "jp": "{p}\n…キッカイな人達だったな",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.39",
  "msg": [
   9350
  ],
  "jp": "蛮子\nねぇねぇ 母ちゃん…\n\n元の世界に戻ったら 俺 男として\n学校に転入出来るかな？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.40",
  "msg": [
   9351
  ],
  "jp": "男子\n男としてって どういう意味？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.41",
  "msg": [
   9352
  ],
  "jp": "蛮子\nあ いやいや 何でもないよ！\nははは…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.42",
  "msg": [
   9353
  ],
  "jp": "蛮千代\nさぁ あんた達 帰るわよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.43",
  "msg": [
   9354
  ],
  "jp": "{p}\n男の子がスケバンで\n女の子が男子かぁ\nもしかして あの子達も\n次元連鎖の影響だったりして…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.44",
  "msg": [
   9360
  ],
  "jp": "イボ痔小五郎\nえっへん！ 事件は みごと解決！\n引き上げるぞ こややしくん！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.45",
  "msg": [
   9361
  ],
  "jp": "こややし少年\nそっか～ 解決したんだぁ～\nじゃ 帰ろうかぁ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.46",
  "msg": [
   9362
  ],
  "jp": "イボ痔小五郎\nこれからも困ったことがあったら\nこの名探偵に相談しなさい！\nはっはっは！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.47",
  "msg": [
   9363
  ],
  "jp": "{p}\n迷探偵…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.48",
  "msg": [
   9365
  ],
  "jp": "宇津木凉\nたとえ身体を奪われようとも\n強い意志があれば\n心を奪われることはない\nそれを おまえは教えてくれた",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.49",
  "msg": [
   9366
  ],
  "jp": "{p}\n宇津木さん…\nでも…\nその先に待っている道は\nつらいものだよ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.50",
  "msg": [
   9367
  ],
  "jp": "宇津木凉\nその通りだ だが それに立ち向かう\n勇気も 君が教えてくれた\nありがとう\n君のことは忘れない…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.51",
  "msg": [
   9368
  ],
  "jp": "{p}\n立ち向かう勇気…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.52",
  "msg": [
   9370
  ],
  "jp": "スラムキング\n外敵を退けたまでのこと\nきさまが気にすることはない\n礼には及ばぬ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.53",
  "msg": [
   9371
  ],
  "jp": "スラムクィーン\n坊や あなた\nあたし好みだったわよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.54",
  "msg": [
   9372
  ],
  "jp": "あしゅら（男）\nドクター・ヘルの命令に従い\n共に戦ったが",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.55",
  "msg": [
   9373
  ],
  "jp": "あしゅら（女）\nおまえの根性 気に入ったわよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.56",
  "msg": [
   9374
  ],
  "jp": "シレーヌ\n戦いこそが デーモンの生き甲斐\n\nこの爪が 次なる獲物を\n求めているぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.57",
  "msg": [
   9375
  ],
  "jp": "シスター・ジル\n魔王の言葉は 美しくもあり\n醜くもあった\nだが パンサークローの好みじゃ\nなかったわ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.58",
  "msg": [
   9376
  ],
  "jp": "アイアンカイザー\n世界が修正を始めたならば\n元の世界へ戻ろう！\n父・邪腕坊が 手天童子を倒す姿を\n見るために！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.59",
  "msg": [
   9377
  ],
  "jp": "ヒゲゴジラ\nいや～ん 帰れるのよ～！\nうれち～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.60",
  "msg": [
   9378
  ],
  "jp": "メドッサ\nダンテが その使命を果たすまで\n私は ダンテと共にある\nそれはまだ 終わってはいない…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.61",
  "msg": [
   9379
  ],
  "jp": "鬼谷\n魔王を倒したことで\n我ら鬼仏衆と手天童子との戦いが\n再び始まろうとしている！\n\nいざ 我が戦場に帰らん！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.62",
  "msg": [
   9380
  ],
  "jp": "来留間源三\n新人類創世が\n俺に課せられた使命なのだ\nそれを阻む魔王との戦いは\n避けられぬ道であった！\nさらばだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.63",
  "msg": [
   9381
  ],
  "jp": "サイコジェニー\n少年よ… 私は待つ…\n次なる目覚めの時を…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.64",
  "msg": [
   9382
  ],
  "jp": "法印大子\n魔王が滅んでも 極悪人ハンターの\nあたしの戦いは終わらないわ！\nすべての世界から 極悪人が\n滅ぶまでね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.65",
  "msg": [
   9390
  ],
  "jp": "{p}\nここには誰か いないかな？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.66",
  "msg": [
   9391
  ],
  "jp": "{p}\n町の人に話を聞いてみよう",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.67",
  "msg": [
   9392
  ],
  "jp": "{p}\n誰かに\n見られているような気がする…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.68",
  "msg": [
   9393
  ],
  "jp": "{p}\nこの中は 他に通じている所は\nないのかな？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.69",
  "msg": [
   9394
  ],
  "jp": "{p}\nここが 明君の言っていた\nシレーヌと 戦った山か…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.70",
  "msg": [
   9503
  ],
  "jp": "不動明\nここは…了の家だ！\nでも…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.71",
  "msg": [
   9504
  ],
  "jp": "不動明\nなんか 周りの景色が\n変わっているような…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.72",
  "msg": [
   9505
  ],
  "jp": "{p}\nでも ここが 了君の家なら\nラッキーだよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.73",
  "msg": [
   9506
  ],
  "jp": "不動明\nそうだね\n中に入ってみよう…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.74",
  "msg": [
   9510
  ],
  "jp": "不動明\nまっくらだよ やだな～",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.75",
  "msg": [
   9511
  ],
  "jp": "{p}\n暗闇に何か光ってるよ…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.76",
  "msg": [
   9512
  ],
  "jp": "不動明\nうわぁ～！\nで 出た～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.77",
  "msg": [
   9513
  ],
  "jp": "飛鳥了\n慌てるな\nよく見ろ 作り物だ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.78",
  "msg": [
   9514
  ],
  "jp": "不動明\n作り物だって…？\nあ 了！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.79",
  "msg": [
   9515
  ],
  "jp": "{p}\nこの人が 飛鳥了君？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.80",
  "msg": [
   9516
  ],
  "jp": "飛鳥了\nこの像は 人間の持つ\n悪魔のイメージ そのもの\nだが この像は 氷河期以前の\n地層から 発見された！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.81",
  "msg": [
   9517
  ],
  "jp": "{p}\nそんな時代に\n人間は いなかったはず…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.82",
  "msg": [
   9518
  ],
  "jp": "不動明\n自然に出来たモノには\n見えないけどなぁ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.83",
  "msg": [
   9519
  ],
  "jp": "飛鳥了\n人間以外の者が作った！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.84",
  "msg": [
   9520
  ],
  "jp": "不動明\n人間以外の者！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.85",
  "msg": [
   9521
  ],
  "jp": "飛鳥了\n人間以前に 地球を支配した人類\nデーモン！\n人間が持つ 悪魔のイメージこそ\n先住人類デーモンの姿なのだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.86",
  "msg": [
   9522
  ],
  "jp": "不動明\n…了のヤツ\nおかしくなっちゃったのかも？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "37.87",
  "msg": [
   9523
  ],
  "jp": "飛鳥了\nこの像は 文字を持たない\nデーモンが残した 歴史書なんだ\n明 この像をかぶってくれ！",
  "en": "",
  "status": "",
  "notes": ""
