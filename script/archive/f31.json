[
 {
  "id": "31.00",
  "msg": [
   5030
  ],
  "jp": "{p}\n緑が多くて 大自然って感じ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.01",
  "msg": [
   5031
  ],
  "jp": "如月ハニー\nしっ！ 何か聞こえるわ！\nケダモノの唸り声みたい…\nだんだん 大きくなるわ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.02",
  "msg": [
   5032
  ],
  "jp": "？？？\nグルルル… グルルルル…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.03",
  "msg": [
   5033
  ],
  "jp": "{p}\n逃げたほうが良くない？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.04",
  "msg": [
   5034
  ],
  "jp": "？？？\nやっと来たかぁ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.05",
  "msg": [
   5035
  ],
  "jp": "？？？\nグオオオオ！\nあれ…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.06",
  "msg": [
   5036
  ],
  "jp": "ハニー\nきゃっ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.07",
  "msg": [
   5037
  ],
  "jp": "{p}\nうわっ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.08",
  "msg": [
   5038
  ],
  "jp": "{p}\nもしかして 今の唸り声 君？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.09",
  "msg": [
   5039
  ],
  "jp": "ケダマン\nえへへ 聞かれちゃった？\n俺 阿仁丸ケダマン！\n怒良野かと思って\n襲っちゃった… ごめんね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.10",
  "msg": [
   5040
  ],
  "jp": "{p}\n君の家 このジャングルの中に\nあるの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.11",
  "msg": [
   5041
  ],
  "jp": "ケダマン\nここが 家ん中だよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.12",
  "msg": [
   5042
  ],
  "jp": "如月ハニー\n野生の生活してるみたいじゃない！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.13",
  "msg": [
   5043
  ],
  "jp": "ケダマン\nみたいでなくて してるのさ！\n野生そのものの生活をよ！\nところで お前ら 誰？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.14",
  "msg": [
   5044
  ],
  "jp": "{p}\n僕 {p}\n彼らは 僕の仲間達だよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.15",
  "msg": [
   5045
  ],
  "jp": "ケダマン\nへぇ 仲間が いっぱい いて\nいいな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.16",
  "msg": [
   5046
  ],
  "jp": "如月ハニー\nところで 怒良野って？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.17",
  "msg": [
   5047
  ],
  "jp": "ケダマン\nドラキュラ族の生き残りさ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.18",
  "msg": [
   5048
  ],
  "jp": "如月ハニー\n…！？\nもしかして 吸血鬼？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.19",
  "msg": [
   5049
  ],
  "jp": "ケダマン\nドラキュラ族は 一般に 血を吸う\n吸血鬼として知られているが…\nあれは間違いなんだ！\n\n正しくは… 血ではなく\n乳を吸い ケツにかぶりつく\n吸ケツ鬼なんだ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.20",
  "msg": [
   5050
  ],
  "jp": "如月ハニー\nいや～ん！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.21",
  "msg": [
   5051
  ],
  "jp": "ケダマン\n怒良野のヤツ おいらに\nライバル心を 燃やしててね\n挑戦状が来たんだ！\n決闘だってさ くくく…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.22",
  "msg": [
   5052
  ],
  "jp": "{p}\nそれで怒良野…って\nここに来るの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.23",
  "msg": [
   5053
  ],
  "jp": "ケダマン\nそ～だよ！\nでもあいつ もしかして…\n門を間違えたのかな？\nま い～や！\nどっかで 怒良野を見かけたら\nおいらが待ってるって伝えてよ！\nじゃな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.24",
  "msg": [
   5054
  ],
  "jp": "如月ハニー\n…変わった子ね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.25",
  "msg": [
   5060
  ],
  "jp": "{p}\n怒良野…？\n変わった名前だな",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.26",
  "msg": [
   5061
  ],
  "jp": "{p}\n怒良野…？\n\n怒良野…って ケダマンの\n決闘相手じゃないか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.27",
  "msg": [
   5062
  ],
  "jp": "{p}\nあの…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.28",
  "msg": [
   5063
  ],
  "jp": "怒良野\nぎゃっ！？\n\nあ～ ビックリした…\n勝手に 人んちに入るなよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.29",
  "msg": [
   5064
  ],
  "jp": "{p}\nごめんなさい…\n\nそれより どうして\nお墓の下に 住んでるの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.30",
  "msg": [
   5065
  ],
  "jp": "怒良野\n地下に こっそり内緒に住んで\n土地は お墓として分譲！\nこれぞドラキュラ族の\n財テクなのだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.31",
  "msg": [
   5066
  ],
  "jp": "{p}\nドラキュラ族…\nそれじゃ君 怒良野君？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.32",
  "msg": [
   5067
  ],
  "jp": "怒良野\n俺を 知ってるのか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.33",
  "msg": [
   5068
  ],
  "jp": "{p}\nケダマンが\n君のこと 待ってるよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.34",
  "msg": [
   5069
  ],
  "jp": "怒良野\nあ～！ しまった！！\n\nケダマンとの 決闘に\n遅刻しちゃった！\n今 行くぞ ケダマン！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.35",
  "msg": [
   5070
  ],
  "jp": "怒良野\nケダマンとの 決闘に\n遅刻しちゃった！\n今 行くぞ ケダマン！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.36",
  "msg": [
   5071
  ],
  "jp": "ケダマン\nよっ！ おまえら！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.37",
  "msg": [
   5072
  ],
  "jp": "{p}\nケダマン！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.38",
  "msg": [
   5073
  ],
  "jp": "ケダマン\nもしかして…と思って\n来てみたんだ\nやっぱり こいつ\n寝過ごしてやんの…！\nうぷぷぷ…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.39",
  "msg": [
   5074
  ],
  "jp": "怒良野\nウルサイ！\n覚悟しろ ケダマン！\n今日は ドラキュラ一族の\n誇りにかけて\nおまえを やっつけてやる！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.40",
  "msg": [
   5075
  ],
  "jp": "ケダマン\nてめ～ 怒良野 卑怯だぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.41",
  "msg": [
   5076
  ],
  "jp": "{p}\n決闘するなら １対１だよ\n怒良野君！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.42",
  "msg": [
   5077
  ],
  "jp": "怒良野\n外野は黙ってろ！\n行くぞ ケダマン！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.43",
  "msg": [
   5078
  ],
  "jp": "{p}\nケダマン 応援するよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.44",
  "msg": [
   5079
  ],
  "jp": "ケダマン\nおう あんがと！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.45",
  "msg": [
   5080
  ],
  "jp": "ケダマン\nいや～ おまえら 強いな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.46",
  "msg": [
   5081
  ],
  "jp": "{p}\nへへっ それほどでもないよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.47",
  "msg": [
   5082
  ],
  "jp": "ケダマン\nところで なんか 町の様子が\n変わってるんだけど…\nなんかあったのかな？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.48",
  "msg": [
   5083
  ],
  "jp": "{p}\n君の町では\n地震が起きてなかったの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.49",
  "msg": [
   5084
  ],
  "jp": "ケダマン\n…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.50",
  "msg": [
   5085
  ],
  "jp": "{p}\n実は…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.51",
  "msg": [
   5086
  ],
  "jp": "ケダマン\nえ～っ！？\nそんなことが起きたの！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.52",
  "msg": [
   5087
  ],
  "jp": "{p}\n何が起きているのか\nまだハッキリとは\nわからないんだけど…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.53",
  "msg": [
   5088
  ],
  "jp": "ケダマン\nおもしろそ～だな～\n俺も一緒に行くぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.54",
  "msg": [
   5089
  ],
  "jp": "怒良野\nぎゃっ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.55",
  "msg": [
   5090
  ],
  "jp": "ケダマン\nおまえも来い！\n\n野生の血が騒ぐぜ！\nうおおおおお！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.56",
  "msg": [
   5091
  ],
  "jp": "ケダマン\nおい 怒良野！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.57",
  "msg": [
   5301
  ],
  "jp": "グレイド\n我はグレイド…\n\n我を忘れたか\n「再生の太陽」よ…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.58",
  "msg": [
   5302
  ],
  "jp": "グレイド\n「破壊の月」と「つがい」を\nなす者よ  聞くがよい…\n世界は 生まれ変わりつつある…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.59",
  "msg": [
   5303
  ],
  "jp": "グレイド\nやがて訪れる結合の時… その時\n\nおまえを 我が元へ いざいない\nすべてを ひとつに…\nあらゆる苦しみや 憎しみ\n悲しみから 解放される世界…\n我と来るなら おまえを すべてから\n解き放ってやろう…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.60",
  "msg": [
   5304
  ],
  "jp": "{p}\n…なんか いろんな記憶が\nごちゃまぜになってる…\n頭が 痛いよ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.61",
  "msg": [
   5305
  ],
  "jp": "如月ハニー\n大丈夫？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.62",
  "msg": [
   5310
  ],
  "jp": "ガードマン\nやはり ここに来ましたね…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.63",
  "msg": [
   5311
  ],
  "jp": "ガードマン\nあなたは ここに来ることに\nなっていたのです\nわかってるでしょ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.64",
  "msg": [
   5312
  ],
  "jp": "{p}\nガードマンさん…\nそうか やっぱり…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.65",
  "msg": [
   5315
  ],
  "jp": "{p}\nイヤな予感がする… この先には\n行かないほうがいいよ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.66",
  "msg": [
   5316
  ],
  "jp": "早見青児\n何言ってるんだよ\n{p}！\n他の道は 戦いが激しくて\nとても通れないぜ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.67",
  "msg": [
   5317
  ],
  "jp": "如月ハニー\n不安なのもわかるけど\n仕方ないわよ 勇気を出して！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.68",
  "msg": [
   5318
  ],
  "jp": "{p}\nう うん…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.69",
  "msg": [
   5320
  ],
  "jp": "{s}\nあたし達は 「破壊の月」と\n「再生の太陽」に されたのは\nま～ったくの\n偶然だった…ってわけ！\n最初は…ね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.70",
  "msg": [
   5321
  ],
  "jp": "{p}\n最初は…って どういう意味？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.71",
  "msg": [
   5322
  ],
  "jp": "{s}\nあなた\nまったく覚えていないのね…\nあなたは１度 魔王の申し出を\n拒絶したのよ\nそして あなたは あなた自身の力\nで 世界を再生したの！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.72",
  "msg": [
   5323
  ],
  "jp": "{p}\nそんなバカな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.73",
  "msg": [
   5324
  ],
  "jp": "{s}\nもうすぐ日蝕だわ\nそしたら 思い出すわよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.74",
  "msg": [
   5325
  ],
  "jp": "{s}\n………",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.75",
  "msg": [
   5326
  ],
  "jp": "{p}\nどうして黙ってるんだい？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.76",
  "msg": [
   5327
  ],
  "jp": "{s}\nあなた\nホントに 何も覚えて無いのね\n無理もないけどね あたしだって\n思い出したの 最近だもん",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.77",
  "msg": [
   5328
  ],
  "jp": "{p}\nさっきから\n何を言ってるんだよ！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.78",
  "msg": [
   5329
  ],
  "jp": "{s}\n世界と同じようにあなたの記憶も\nまるでツギハギね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.79",
  "msg": [
   5330
  ],
  "jp": "{p}\n僕の記憶も…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.80",
  "msg": [
   5341
  ],
  "jp": "{s}\n魔王が何故 あなたを 次元牢獄に\n閉じ込めたか わかる？\nあなたに\n思い出して欲しいからよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.81",
  "msg": [
   5342
  ],
  "jp": "{p}\n思い出す…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.82",
  "msg": [
   5343
  ],
  "jp": "{s}\nあなた 次元牢獄で起きたような\n悲劇を １度 見ているでしょ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.83",
  "msg": [
   5344
  ],
  "jp": "{p}\n美樹ちゃんが 暴徒に…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.84",
  "msg": [
   5345
  ],
  "jp": "{s}\n思い出しのね 明君の身に起きた\n悲しい出来事を…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.85",
  "msg": [
   5346
  ],
  "jp": "{p}\nうぅ… 頭が 痛み始めた…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.86",
  "msg": [
   5347
  ],
  "jp": "{s}\n頭が痛いの？ そう…\nきっと 思い出したくないのね\n魔王を止めなきゃ…って\n思い込んでる あなたにとって\n理解するのは難しいことだもの…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "31.87",
  "msg": [
   5348
  ],
