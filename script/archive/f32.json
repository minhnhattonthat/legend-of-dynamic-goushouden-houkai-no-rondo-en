[
 {
  "id": "32.00",
  "msg": [
   5363
  ],
  "jp": "{s}\n間違っていないわ！\n騙されてもいない！\nだって魔王は あの悲劇を\n防ぐことが出来るのよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.01",
  "msg": [
   5364
  ],
  "jp": "{p}\nあの悲劇を…\n防ぐことが出来る…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.02",
  "msg": [
   5370
  ],
  "jp": "{s}\n同じことの繰り返しに\n何の意味がある！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.03",
  "msg": [
   5371
  ],
  "jp": "グレイド\n日蝕が始まり\n我が力は 頂点に達した\n日蝕が終わるまで 我が力は\n維持されたままだ\nかつて 貴様に告げた言葉だ\nこの場所で…な\n貴様 本当に 我に勝ったと\n思ったのか？\n我が力は… 日蝕が終わるまで\n維持されたままなのだぞ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.04",
  "msg": [
   5372
  ],
  "jp": "グレイド\n貴様が何故 「再生の太陽」と\n呼ばれたか 解ったか？\n再生したのだよ 貴様は…\n世界を思い通りに…な！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.05",
  "msg": [
   5373
  ],
  "jp": "{p}\n…！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.06",
  "msg": [
   5374
  ],
  "jp": "グレイド\nだが貴様には 迷いがあった\n世界をどうすべきか解らなかった\nそのため「始まりの丘」から\n同じことが 繰り返されたのだ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.07",
  "msg": [
   5375
  ],
  "jp": "{p}\nそ そんな…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.08",
  "msg": [
   5386
  ],
  "jp": "グレイド\n不動明の身に起こる出来事を\n知っている おまえは\n不動明から逃げたのだ そして\n如月ハニーと 行動を共にした",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.09",
  "msg": [
   5387
  ],
  "jp": "{p}\n違う！ あの時は {s}が\n誰と行くかを勝手に決めたんだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.10",
  "msg": [
   5388
  ],
  "jp": "グレイド\n勝手に決めたと思うか…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.11",
  "msg": [
   5389
  ],
  "jp": "{s}\nあたしが 勝手に 決めたと\n思ってるの…？ ひどいわ…\nあたしは あなたが もう\nあんな悲劇は 見たくないって\nそう思っているのが解ったから…\nだから…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.12",
  "msg": [
   5390
  ],
  "jp": "{p}\n{s}…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.13",
  "msg": [
   5391
  ],
  "jp": "{s}\nあなたのことを想って\nしたことなのに！ なのに！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.14",
  "msg": [
   5392
  ],
  "jp": "{p}\n………",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.15",
  "msg": [
   5393
  ],
  "jp": "{s}\nひどい…\n言葉には出さなくても\nあたしの気持ち 伝わっていると\n思っていたのに…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.16",
  "msg": [
   5394
  ],
  "jp": "{p}\nごめんよ {s}…\n本当に ごめん…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.17",
  "msg": [
   5395
  ],
  "jp": "{s}\nいいの もう いいのよ…\n\nどうせ こうなる\n運命だったのだから…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.18",
  "msg": [
   5396
  ],
  "jp": "グレイド\n受けれいるのだ\n{p}よ…\n我と 同調すれば 安定した\n平和な世界を 創り出せる\nすべての悲劇は防げるのだ…\n誰も苦しまず 悲しまない",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.19",
  "msg": [
   5397
  ],
  "jp": "グレイド\nすべての迷いを消し去るのだ…\n\n案ずることはない…\n我にすべて ゆだねるのだ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.20",
  "msg": [
   5398
  ],
  "jp": "{p}\n本当に 悲劇を防げるの？\n誰も苦しまず 悲しまないの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.21",
  "msg": [
   5399
  ],
  "jp": "グレイド\n我を信じよ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.22",
  "msg": [
   5400
  ],
  "jp": "如月ハニー\nいけない！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.23",
  "msg": [
   5401
  ],
  "jp": "{p}\nハニー！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.24",
  "msg": [
   5402
  ],
  "jp": "グレイド\n現れたな ザコどもが…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.25",
  "msg": [
   5403
  ],
  "jp": "如月ハニー\n自分の運命を 他人にゆだねては\nダメよ！\nあなたは あなた自身の手で\n運命を変えなさい！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.26",
  "msg": [
   5404
  ],
  "jp": "グレイド\n愚かな…\n人間の力には 限りがある！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.27",
  "msg": [
   5405
  ],
  "jp": "如月ハニー\nその限界に 挑戦し続けるのが\n人間よ 魔王！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.28",
  "msg": [
   5406
  ],
  "jp": "{p}\nハニー！\nそうだね そのとおりだ！\n魔王！\n僕は あきらめない！\nおまえの思い通りには\nさせない！\n何度 同じことを繰り返そうとも\n僕は おまえと戦う！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.29",
  "msg": [
   5407
  ],
  "jp": "グレイド\n愚か者めらが！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.30",
  "msg": [
   5411
  ],
  "jp": "{p}\n本当に 魔王は死んだのかな…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.31",
  "msg": [
   5412
  ],
  "jp": "如月ハニー\n「これで終わりではない！」\nなんて 悪役の捨てセリフよ！\n気にしなくても平気よ\n{p}！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.32",
  "msg": [
   5413
  ],
  "jp": "{p}\nごめんね {s}…\n\nやっぱり 僕は 君を助けることが\n出来なかった…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.33",
  "msg": [
   5414
  ],
  "jp": "{p}\nあの時 ハニーが来なかったら\n僕は きっと…\n僕は きっと 魔王の考えを\n受けいれていた…\n{s}…\n僕 恐いよ…\nまた\n繰り返されるのかと思うと…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.34",
  "msg": [
   5415
  ],
  "jp": "{p}\n{s}…\n僕 恐いよ…\nまた\n繰り返されるのかと思うと…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.35",
  "msg": [
   5416
  ],
  "jp": "{p}\nだけど… 元の世界に戻れば…\nまた 君に逢えるはず！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.36",
  "msg": [
   5417
  ],
  "jp": "{p}\n日蝕の間 魔王の力は\n維持され続ける\n日蝕の間だけが 僕らが 元の世界に\n戻れるチャンスだった…\nその力は\nどこから 生み出されたのか…\nそんなことが出来るのは\nいったい誰か…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.37",
  "msg": [
   5418
  ],
  "jp": "{p}\nそれが出来るのは…\n魔王だけだ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.38",
  "msg": [
   5419
  ],
  "jp": "{p}\n魔王の言うなりになって\n魔王に取り込まれていたら…\n僕は すべての苦しみから\n解放された…はず\nでも…そしたら 僕は\n君と再び逢えただろうか…！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.39",
  "msg": [
   5420
  ],
  "jp": "{p}\nハァ… ハァ…\n\nでも！ そしたら 僕は\n君と再び逢えただろうか…！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.40",
  "msg": [
   5421
  ],
  "jp": "{p}\nたとえ…\nたとえ 何度繰り返そうとも！\n僕は 魔王の申し出を断る！\n\nそして…\nいつか絶対 やっつけてやる！\nだって…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.41",
  "msg": [
   5422
  ],
  "jp": "{p}\nハァ… ハァ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.42",
  "msg": [
   5423
  ],
  "jp": "{p}\n自分で決めたことだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "32.43",
  "msg": [
   5424
  ],
  "jp": "{p}\nハァ… ハァ…",
  "en": "",
  "status": "",
  "notes": ""
 },
