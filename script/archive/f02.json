   1411
  ],
  "jp": "ドラゴン\nも 申し訳ありません！！\n\n後一歩というところまで\n追い詰めたのですが\n見慣れぬ輩が 邪魔をしまして…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.83",
  "msg": [
   1412
  ],
  "jp": "スラムキング\n見慣れぬ輩…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.84",
  "msg": [
   1413
  ],
  "jp": "ドラゴン\nそれがどうも…\nこ 子供だったようで…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.85",
  "msg": [
   1414
  ],
  "jp": "スラムキング\nドラゴンが\n子供にやられたと申すのか！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.86",
  "msg": [
   1415
  ],
  "jp": "ドラゴン\nも 申し訳ありません！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.87",
  "msg": [
   1416
  ],
