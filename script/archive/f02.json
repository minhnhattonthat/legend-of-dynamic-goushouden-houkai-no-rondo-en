[
 {
  "id": "02.00",
  "msg": [
   1310
  ],
  "jp": "あゆ子の父\n娘の姿が 見えんのだ…\n\n日本政府が 関東を見捨ててから\n無法者が集まるばかり…\nあゆ子のことが 心配だ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.01",
  "msg": [
   1311
  ],
  "jp": "住民\n関東地獄地震から数年たったけど\n暮らしは 酷いものだ\n暴力が支配する世界じゃ\n弱者は 苦しむだけだ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.02",
  "msg": [
   1312
  ],
  "jp": "如月ハニー\nこの集落 様子が おかしいわよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.03",
  "msg": [
   1313
  ],
  "jp": "{p}\n大地震が あったみたいだね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.04",
  "msg": [
   1314
  ],
  "jp": "如月ハニー\n関東地獄地震？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.05",
  "msg": [
   1315
  ],
  "jp": "{p}\nうん 確かに 大地震から\n数年後…って感じだね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.06",
  "msg": [
   1316
