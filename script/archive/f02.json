  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.88",
  "msg": [
   1417
  ],
  "jp": "スラムキング\nどうした クィーン\n顔色が すぐれぬぞ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.89",
  "msg": [
