  "status": "",
  "notes": ""
 },
 {
  "id": "02.61",
  "msg": [
   1386
  ],
  "jp": "ジャック\n俺と関ったら ただでは済まんぞ\n\nそれでもいいのか！？\n{p}！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.62",
