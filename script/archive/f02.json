  "notes": ""
 },
 {
  "id": "02.58",
  "msg": [
   1383
  ],
  "jp": "{p}\nな なに？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.59",
  "msg": [
   1384
  ],
  "jp": "ジャック\n名は…\n名は なんという…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "02.60",
  "msg": [
   1385
  ],
  "jp": "{p}\n…{p}",
