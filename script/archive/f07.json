[
 {
  "id": "07.00",
  "msg": [
   1957
  ],
  "jp": "閻魔大王\n様々な世界が ツギハギのように\n繋がり始めている…\nいったい 何が起ころうとしておる\nのじゃ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "07.01",
  "msg": [
   1958
  ],
  "jp": "えん魔くん\n大王様 こいつは 妖怪パトロールの\n新メンバーなんです！\n{p}は\n妖怪・ハチの巣入道を\nやっつけたんです！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "07.02",
  "msg": [
   1960
  ],
  "jp": "閻魔大王\nうむ！\n京都に 亜空間を作ってやろう！\nまずは おまえ達を送り込み\n続いて地獄別荘をそこに移そう！\nその前に えん魔よ\nこれを持っていくがよい",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "07.03",
  "msg": [
   1961
  ],
  "jp": "閻魔大王\nこれは 地獄別荘にいる仲間を\n瞬時に 呼び出したり\nまた逆に 仲間を地獄別荘に送る\nこともできる 道具なのじゃ\n人間界で使う限り\nどんな場所でも使えるはずじゃ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "07.04",
  "msg": [
   1962
  ],
  "jp": "えん魔くん\nへぇ そいつは便利な道具だな\nありがとう 閻魔大王様！\nよ～し！\n京都で鬼退治だ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "07.05",
  "msg": [
   1963
  ],
  "jp": "{p}\n大王様 ありがとう！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "07.06",
  "msg": [
   1964
  ],
  "jp": "閻魔大王\n行け 京都へ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "07.07",
  "msg": [
   1965
  ],
  "jp": "{p}\nそれじゃ 明君の世界と…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "07.08",
  "msg": [
