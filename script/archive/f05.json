[
 {
  "id": "05.00",
  "msg": [
   1704
  ],
  "jp": "{p}\n十兵衛を返せ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.01",
  "msg": [
   1705
  ],
  "jp": "丸ゴシ\nワシを倒すことが出来たなら\n返してやるわ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.02",
  "msg": [
   1706
  ],
  "jp": "十兵衛\nえ～ん 恐かったよぉ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.03",
  "msg": [
   1707
  ],
  "jp": "山岸\nよちよち\nもう だいじょぶだからさ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.04",
  "msg": [
   1708
  ],
  "jp": "十兵衛\n山岸君だけじゃなく\nあたしまで助けてくれて…\n何か お礼をしなくちゃね！\n\nあたしも 柳生忍者の末裔！\n恩には報いるわ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.05",
  "msg": [
   1709
  ],
  "jp": "山岸\nそうだぜ 俺だって このままじゃ\n気が済まねぇや！\n困ったことがあったら\n言ってくれよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.06",
  "msg": [
   1710
  ],
  "jp": "如月ハニー\nこの際だから 相談してみたら？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.07",
  "msg": [
   1711
  ],
  "jp": "早見青児\nもしかしたら 何かヒントが\n得られるかもしれないぜ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.08",
  "msg": [
   1712
  ],
  "jp": "{p}\nうん\n実は…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.09",
  "msg": [
   1713
  ],
  "jp": "十兵衛＆山岸\nえ～！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.10",
  "msg": [
   1714
  ],
  "jp": "十兵衛\n…不思議な話ね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.11",
  "msg": [
   1715
  ],
  "jp": "山岸\n黒い月に 関東地獄地震？\nそして 蓮沼に浮かぶ屋敷だって？\nおもしろそうだな…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.12",
  "msg": [
   1716
  ],
  "jp": "十兵衛\nおもしろがっちゃダメでしょ！\n謎を解くお手伝いをしないとね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.13",
  "msg": [
   1717
  ],
  "jp": "袋小路\nあ オヤブン！\n俺を置いて行くなんて！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.14",
  "msg": [
   1718
  ],
  "jp": "丸ゴシ\nワシに逆らったら どうなるか\n見てろよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.15",
  "msg": [
   1719
  ],
  "jp": "パラソル\n助けてくれバイ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.16",
  "msg": [
   1720
  ],
  "jp": "マカロニ・キッド\n俺を放せ！ 逆らうと 早撃ちが\nモノを言うぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.17",
  "msg": [
   1721
  ],
  "jp": "ヒゲゴジラ\n山岸君\nわたちたち お友達じゃないの！\n仲良くやりまちょうね～\nおほほほ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.18",
  "msg": [
   1722
  ],
  "jp": "山岸\nみんな ありがとな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.19",
  "msg": [
   1723
  ],
  "jp": "袋小路\nそういえばオヤブン\n聞きましたか？\n体育倉庫にバケモノが\n出るそうですよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.20",
  "msg": [
   1724
  ],
  "jp": "山岸\nバケモノ！？\nこっちも おもしろそうだな",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.21",
  "msg": [
   1725
  ],
  "jp": "山岸\nなあ {p}\n体育倉庫に行ってみないか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.22",
  "msg": [
   1726
  ],
  "jp": "十兵衛\nそうね なにか蓮沼に\n関係あるかもしれないしね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.23",
  "msg": [
   1730
  ],
  "jp": "丸ゴシ\nなに？ 体育倉庫の鍵だと？\n知らん 知らん！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.24",
  "msg": [
   1731
  ],
  "jp": "マカロニ・キッド\n体育倉庫の鍵？\n\n明日をも知らねー流れ者が\nそんなの知るか！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.25",
  "msg": [
   1732
  ],
  "jp": "ヒゲゴジラ\n体育倉庫の鍵なんて\n持ってないわよ～！\nポケットに入ってるけど\n持ってないわよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.26",
  "msg": [
   1733
  ],
  "jp": "{p}\nポケットに入ってる…ね？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.27",
  "msg": [
   1734
  ],
  "jp": "生徒\n時々 体育倉庫の中から\n声がするんだけど\n誰か 先生達に\n閉じ込められてるのかな？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.28",
  "msg": [
   1735
  ],
  "jp": "生徒\nあいつら いい気味だぜ！\nさ～て 弁当食べよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.29",
  "msg": [
   1736
  ],
  "jp": "生徒\n山岸君 行っちゃうの？\n\n寂しいけど しばらく 静かになって\nいいかも…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.30",
  "msg": [
   1737
  ],
  "jp": "山岸\nなんだとぉ～！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.31",
  "msg": [
   1738
  ],
  "jp": "生徒\nきゃ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.32",
  "msg": [
   1739
  ],
  "jp": "生徒\n十兵衛… 山岸君…\n気をつけてね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.33",
  "msg": [
   1740
  ],
  "jp": "生徒\n僕 一生懸命勉強して そして…\nハレンチ学園の先生になるんだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.34",
  "msg": [
   1741
  ],
  "jp": "生徒\n先生もいなくなったし 教室で\nキャンプファイアでもするか！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.35",
  "msg": [
   1742
  ],
  "jp": "山岸\nいつのまに 校舎の屋上へ！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.36",
  "msg": [
   1750
  ],
  "jp": "{p}\n鍵が かかっていて 開かないや\n\nでも 見たところ\n普通の体育倉庫だけど…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.37",
  "msg": [
   1751
  ],
  "jp": "十兵衛\nおかしいわね\nいつもは 開いてるのに…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.38",
  "msg": [
   1752
  ],
  "jp": "？？？\n学園を 混乱させる者達が\n加わった…\nそして 世界を超える者達が\n加わる…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.39",
  "msg": [
   1760
  ],
  "jp": "早見青児\nげげっ！ 閉じ込められた！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.40",
  "msg": [
   1761
  ],
  "jp": "如月ハニー\nいや～ん 出してぇ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.41",
  "msg": [
   1762
  ],
  "jp": "カパエル\nうるへ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.42",
  "msg": [
   1763
  ],
  "jp": "{p}\nあ 誰かいたのか！\nん？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.43",
  "msg": [
   1764
  ],
  "jp": "如月ハニー\nちょっと その子…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.44",
  "msg": [
   1765
  ],
  "jp": "{p}\nうわ～！\n河童！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.45",
  "msg": [
   1766
  ],
  "jp": "カパエル\nなんや こいつら…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.46",
  "msg": [
   1767
  ],
  "jp": "えん魔くん\nカパエル なに騒いでるんだ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.47",
  "msg": [
   1768
  ],
  "jp": "カパエル\n騒いでんのは こいつらどっせ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.48",
  "msg": [
   1769
  ],
  "jp": "{p}\nき 君は誰？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.49",
  "msg": [
   1770
  ],
  "jp": "えん魔くん\n俺たちゃ 地獄界から\n妖怪退治に来たもんだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.50",
  "msg": [
   1771
  ],
  "jp": "早見青児\n妖怪退治？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.51",
  "msg": [
   1772
  ],
  "jp": "如月ハニー\n地獄界？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.52",
  "msg": [
   1773
  ],
  "jp": "えん魔くん\n俺は えん魔",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.53",
  "msg": [
   1774
  ],
  "jp": "カパエル\nボク カパエル",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.54",
  "msg": [
   1775
  ],
  "jp": "雪子姫\nあたしは 雪子姫よ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.55",
  "msg": [
   1776
  ],
  "jp": "シャッポじい\nわしゃ シャッポじい じゃ\nひょひょひょ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.56",
  "msg": [
   1777
  ],
  "jp": "えん魔くん\nむっ！？\n\nおまえら\n妖怪に 取り憑かれているなー？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.57",
  "msg": [
   1778
  ],
  "jp": "えん魔くん\n俺のマユ毛は\n妖怪を探る アンテナだ\nそのアンテナがおまえらの身体から\n妖気を感じているってわけだよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.58",
  "msg": [
   1779
  ],
  "jp": "{p}\nじゃ じゃあ 僕\n妖怪に 取り憑かれているの～？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.59",
  "msg": [
   1780
  ],
  "jp": "早見青児\nもしかして 家がなくなったのも\n呪われてるから…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.60",
  "msg": [
   1781
  ],
  "jp": "えん魔くん\n何か 変わったことがあるはずだ\nそいつを 俺に話すんだ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.61",
  "msg": [
   1782
  ],
  "jp": "{p}\n実は…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.62",
  "msg": [
   1783
  ],
  "jp": "早見青児\n実は！ 俺の家があるはずの場所が\n沼になっていた！ おまけに…\n黒い月が浮かぶ時 その沼に屋敷が\n浮かぶって 言うんだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.63",
  "msg": [
   1784
  ],
  "jp": "えん魔くん\nぎゃっはっはっは！\n\n黒い月が出ると\n沼に屋敷が浮かぶだって！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.64",
  "msg": [
   1785
  ],
  "jp": "雪子姫\nあんまり笑っちゃ失礼よ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.65",
  "msg": [
   1786
  ],
  "jp": "えん魔くん\nその屋敷に 行きたければ\n沼に戻ってみなよ じゃあな！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.66",
  "msg": [
   1787
  ],
  "jp": "{p}\n黒い月が輝く時\nお逢いしましょう…\nもしかして あのメールは\nえん魔くんから…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.67",
  "msg": [
   1788
  ],
  "jp": "十兵衛\nそうみたい",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.68",
  "msg": [
   1789
  ],
  "jp": "{p}\n生徒も生徒なら 先生も先生…って\n気がするけど\n柱に縛りつけられているのを\n放っては おけないよね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.69",
  "msg": [
   1790
  ],
  "jp": "十兵衛\nでしょ！\nみんなも 協力してくれる？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.70",
  "msg": [
   1791
  ],
  "jp": "{p}\nうん\n山岸君を助けに行こう！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.71",
  "msg": [
   1792
  ],
  "jp": "住民\n変わった事って言えば\nそこの学校は変わってるわよ\n教師も生徒も元気がありあまってて\n毎日 救急車の世話になってるの",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.72",
  "msg": [
   1793
  ],
  "jp": "住民\n奇妙な人達なら知ってるよ\n泣く子もだまる悪党一家\n父親は超能力者 息子達は\nスケベ サイボーグ 爆弾使い\nでも長女は かわいいんだァ～",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.73",
  "msg": [
   1801
  ],
  "jp": "竜馬\n急に暗くなったね…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.74",
  "msg": [
   1802
  ],
  "jp": "門土\nまだ昼間だぜ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.75",
  "msg": [
   1803
  ],
