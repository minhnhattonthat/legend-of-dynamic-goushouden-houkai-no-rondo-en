  "status": "",
  "notes": ""
 },
 {
  "id": "05.84",
  "msg": [
   1812
  ],
  "jp": "雪子姫\nいらっしゃ～い！\n待ってたわよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "05.85",
  "msg": [
   1813
  ],
  "jp": "早見青児\nなんだよ これ？\n薄気味悪い ドアベルだな？",
