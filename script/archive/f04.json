[
 {
  "id": "04.00",
  "msg": [
   1556
  ],
  "jp": "{p}\nこれなら みんな乗れるね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.01",
  "msg": [
   1560
  ],
  "jp": "ドラゴン\nスラムキング様の 許可なく\nこの先へ進むことは許さん！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.02",
  "msg": [
   1561
  ],
  "jp": "門土\nおい 関所に誰もいないぜ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.03",
  "msg": [
   1562
  ],
  "jp": "竜馬\nスラムキングが ジャックに負けて\n逃げ出したんじゃない？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.04",
  "msg": [
   1563
  ],
  "jp": "{p}\n…関所の向こうに\n何があるんだろう\n{s}…\nあいつ 無事かな…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.05",
  "msg": [
   1564
  ],
  "jp": "ジャック\n…また会ったな {p}",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.06",
  "msg": [
   1565
  ],
  "jp": "ジャック\n…覚えてないのか\n\nこれも ヤツの仕業か…\nそれとも…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.07",
  "msg": [
   1566
  ],
  "jp": "{p}\nちょ ちょっと何を言ってるの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.08",
  "msg": [
   1567
  ],
  "jp": "ジャック\nいずれ解る… 俺と関ったら\nただでは済まんことも…な",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.09",
  "msg": [
   1570
  ],
  "jp": "店主\nついに この町にもドラゴンが…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.10",
  "msg": [
   1571
  ],
  "jp": "店主\n死神警察署は この町から\n南東に向かったとこにある\nあゆ子ちゃん\n無事だといいんだがな…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.11",
  "msg": [
   1572
  ],
  "jp": "店主\n腹が減ったなら いつでも\nたらふく 食わせてやるぞ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.12",
  "msg": [
   1601
  ],
  "jp": "早見青児\nおかしいなぁ…\nこのあたりのはずなんだけど…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.13",
  "msg": [
   1602
  ],
  "jp": "如月ハニー\n青児君のお父様\nこんな森の中に 住んでるの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.14",
  "msg": [
   1603
  ],
  "jp": "早見青児\nいや 住宅地の ど真ん中だよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.15",
  "msg": [
   1604
  ],
  "jp": "{p}\nどう見ても ここ\n住宅地じゃないよ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.16",
  "msg": [
   1605
  ],
  "jp": "早見青児\nだよなぁ…？\n方角は合ってるんだけど…\nうちの近所に 沼なんか\n無かったしなぁ…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.17",
  "msg": [
   1606
  ],
  "jp": "{p}\n少しまわりを 歩いてみようよ\nまわりを見渡せば 何か解るかも？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.18",
  "msg": [
   1607
  ],
  "jp": "早見青児\nとほほ… 申し訳ない…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.19",
  "msg": [
   1610
  ],
  "jp": "住民\nえ？ 町の南東にある沼？\nあぁ 蓮沼のことかい？\nあの沼なら\nず～っと昔からあるぞ？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.20",
  "msg": [
   1611
  ],
  "jp": "住民\n町の南東にあった 蓮沼が消えて\n住宅地が 現れたんだ！\nいや そんな気がするだけで\n昔から住宅地だったのかも…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.21",
  "msg": [
   1614
  ],
  "jp": "住民\nあんたら見たかい？\n町の向こうにある デッカイ壁！\n…ドラゴンの関所のことかって？\nあんたら 何言ってんだ？\nありゃ 高速道路の工事だよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.22",
  "msg": [
   1618
  ],
  "jp": "{p}\nなんか 妙だね…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.23",
  "msg": [
   1619
  ],
  "jp": "ジャック\nこの町は 関東ではない！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.24",
  "msg": [
   1620
  ],
  "jp": "早見青児\nいや そんなことないんだけど…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.25",
  "msg": [
   1621
  ],
  "jp": "ジャック\n少なくとも 俺の知る関東では\nないということだ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.26",
  "msg": [
   1622
  ],
  "jp": "{p}\n確かに どこにも 震災の跡は\n見当たらないね…\n普通の…\nうん ごく普通の町に見えるよ\nまるで…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.27",
  "msg": [
   1623
  ],
  "jp": "{p}\n…違う世界の町みたいだ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.28",
  "msg": [
   1624
  ],
  "jp": "早見青児\n確かに 俺 関東地獄地震なんて\n知らないしなぁ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.29",
  "msg": [
   1625
  ],
  "jp": "如月ハニー\nパパの死が別世界の出来事だったら\nどんなにいいか…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.30",
  "msg": [
   1626
  ],
  "jp": "{p}\nハニー…\n\nここが どんな世界であれ\nもっと調べてみないと…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.31",
  "msg": [
   1627
  ],
  "jp": "住民\n奇妙って言えば\n俺 聞いたんだ\n学校のあたりで\n裸の女性を見たんだって！\nホントだったら\nこりゃけっこうな話だね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.32",
  "msg": [
   1628
  ],
  "jp": "住民\n何か変わったことは\n無かったかって？\nそこの学校の先生なら\n変わった人達ばかりだよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.33",
  "msg": [
   1629
  ],
  "jp": "住民\nちょいと そこの人！\nあんたは 信じてくれるかな？\nおもしろい話が あるんだけど\n聞いてってよ ね！ ね！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.34",
  "msg": [
   1630
  ],
  "jp": "住民\n誰も信じてくれないんだけどさ…\n\nなんと 沼の中に\n屋敷が 浮かんでたんだぜ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.35",
  "msg": [
   1631
  ],
  "jp": "如月ハニー\n沼に屋敷が浮かんでた ですって？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.36",
  "msg": [
   1632
  ],
  "jp": "住民\nあ～ やっぱ 疑ってる～！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.37",
  "msg": [
   1633
  ],
  "jp": "{p}\nごめん ごめん\n疑ってないから 話を続けてよ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.38",
  "msg": [
   1634
  ],
  "jp": "早見青児\n取材なら 新聞記者の俺に\n任せてよ！\nねぇ 君\n疑ってないから おせ～て",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.39",
  "msg": [
   1635
  ],
  "jp": "住民\n疑ってないならよし～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.40",
  "msg": [
   1636
  ],
  "jp": "早見青児\n蓮沼に 屋敷が浮かぶ時って\n何か 予兆でもあるのかい？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.41",
  "msg": [
   1637
  ],
  "jp": "住民\nそ～いえば 黒い月が浮かぶな…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.42",
  "msg": [
   1638
  ],
  "jp": "{p}\n黒い月！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.43",
  "msg": [
   1639
  ],
  "jp": "住民\nひぇ～～～！！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.44",
  "msg": [
   1640
  ],
  "jp": "如月ハニー\n今の 聞いた？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.45",
  "msg": [
   1641
  ],
  "jp": "早見青児\n黒い月…って 言ってたな",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.46",
  "msg": [
   1642
  ],
  "jp": "竜馬\n蓮沼まで 戻ってみる？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.47",
  "msg": [
   1650
  ],
  "jp": "早見青児\nハレンチ学園？\n聞いたことないなぁ…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.48",
  "msg": [
   1651
  ],
  "jp": "{p}\nジャック 何を見てるの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.49",
  "msg": [
   1652
  ],
  "jp": "如月ハニー\n…あ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.50",
  "msg": [
   1653
  ],
  "jp": "門土\nおいおい\n誰か 縛りつけられてるぜ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.51",
  "msg": [
   1654
  ],
  "jp": "竜馬\nここ学校でしょ？\n宿題 忘れたんじゃないの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.52",
  "msg": [
   1655
  ],
  "jp": "{p}\n助けたほうが いいんじゃない？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.53",
  "msg": [
   1656
  ],
  "jp": "ジャック\nそう思うか {p}…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.54",
  "msg": [
   1657
  ],
  "jp": "{p}\nう うん…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.55",
  "msg": [
   1658
  ],
  "jp": "ジャック\nならば 行こう…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.56",
  "msg": [
   1660
  ],
  "jp": "{p}\nうわ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.57",
  "msg": [
   1661
  ],
  "jp": "如月ハニー\nきゃ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.58",
  "msg": [
   1662
  ],
  "jp": "竜馬\nなんだ なんだ！？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.59",
  "msg": [
   1663
  ],
  "jp": "丸ゴシ\nがっはっはっは！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.60",
  "msg": [
   1664
  ],
  "jp": "ヒゲゴジラ\nおほほほ\nざま～ごらんあそばせ\n山岸を助けようったって\nそうはイカのキンちゃんよ\n…あらら 十兵衛ちゃん達かと\n思ったら 違うわね\nうちの生徒でも　ないみたいよ～！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.61",
  "msg": [
   1665
  ],
  "jp": "門土\n出せ この野郎！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.62",
  "msg": [
   1666
  ],
  "jp": "{p}\n人違いなら 出してくれよ！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.63",
  "msg": [
   1667
  ],
  "jp": "丸ゴシ\n構わねぇから放り込んでおきなさい\n吉永先生！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.64",
  "msg": [
   1668
  ],
  "jp": "ヒゲゴジラ\nおほほほ それもそうよね\nなんか 凶暴そうだし…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.65",
  "msg": [
   1669
  ],
  "jp": "若い女の子\nあいつら　人違いしちゃった…\nねえ　どうする？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.66",
  "msg": [
   1670
  ],
  "jp": "若い女の子\n………",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.67",
  "msg": [
   1671
  ],
  "jp": "如月ハニー\nまったくもう…！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.68",
  "msg": [
   1672
  ],
  "jp": "門土\nひでぇめにあったぜ！\nあの野郎！ とっちめてやる！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.69",
  "msg": [
   1673
  ],
  "jp": "{p}\nここは…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.70",
  "msg": [
   1674
  ],
  "jp": "早見青児\nもしや…？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.71",
  "msg": [
   1675
  ],
  "jp": "竜馬\nよりによって\nトイレに閉じ込められた！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.72",
  "msg": [
   1676
  ],
  "jp": "{p}\n…なんとか ここから出る方法を\n探さないとね",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.73",
  "msg": [
   1677
  ],
  "jp": "謎の少女\nこんにちは！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.74",
  "msg": [
   1678
  ],
  "jp": "謎の少女\nここは…男子トイレ！\nいや～も～ あたしったら！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.75",
  "msg": [
   1679
  ],
  "jp": "{p}\n…あの 君は誰？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.76",
  "msg": [
   1680
  ],
  "jp": "謎の少女\nあ ごめんなさい\n\nあたしは 柳生十兵衛みつ子\n十兵衛って呼んで",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.77",
  "msg": [
   1681
  ],
  "jp": "十兵衛\nあなた達\nあたしと 間違えられたの！\nそれで あたし あなた達を\n助けに来たってわけ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.78",
  "msg": [
   1682
  ],
  "jp": "如月ハニー\nあいつら なにもの？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.79",
  "msg": [
   1683
  ],
  "jp": "十兵衛\nヒゲゴジラと 丸ゴシは\nこの学校の先生よ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.80",
  "msg": [
   1684
  ],
  "jp": "十兵衛\nあいつら みんなに苛められた\n仕返しを するつもりなの",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.81",
  "msg": [
   1685
  ],
  "jp": "早見青児\n苛めたくなる気持ちは 解るけど\nでも先生でしょ…",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.82",
  "msg": [
   1686
  ],
  "jp": "十兵衛\nだって 苛めると喜ぶんだもん",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.83",
  "msg": [
   1687
  ],
  "jp": "十兵衛\nヒゲゴジラのヤツ\n丸ゴシを 抱き込んで\n山岸君を 捕まえちゃったの",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.84",
  "msg": [
   1688
  ],
  "jp": "門土\n校庭の柱に 縛り付けられていた\nあいつか？",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.85",
  "msg": [
   1689
  ],
  "jp": "十兵衛\nうん",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.86",
  "msg": [
   1690
  ],
  "jp": "竜馬\nそうかぁ あの罠は 君を捕まえる\nための ものだったんだ",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.87",
  "msg": [
   1691
  ],
  "jp": "ヒゲゴジラ\n山岸を助けようったって\nそうはいかないわよー！",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "04.88",
  "msg": [
   1692
  ],
  "jp": "山岸\nやい ヒゲゴジラ！\nよくも俺様を 苛めやがったな！\nぶっとばすぞ！",
